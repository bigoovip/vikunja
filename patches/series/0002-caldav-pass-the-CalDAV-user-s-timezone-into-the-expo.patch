From e999ae719eb30c416f91e7b032163ee280dd37bc Mon Sep 17 00:00:00 2001
From: bigoovip <86590318+bigoovip@users.noreply.github.com>
Date: Tue, 20 Oct 2026 15:23:19 +0800
Subject: [PATCH 2/2] caldav: pass the CalDAV user's timezone into the export

The storage provider reads users.timezone (empty/invalid falls back to nil, i.e.
the historical UTC-only export) and hands it to GetCaldavTodosForTasks for both
list and sync-collection requests.
---
 pkg/routes/caldav/listStorageProvider.go | 47 +++++++++++++++++++-----
 pkg/routes/caldav/sync_collection.go     |  2 +-
 2 files changed, 39 insertions(+), 10 deletions(-)

diff --git a/pkg/routes/caldav/listStorageProvider.go b/pkg/routes/caldav/listStorageProvider.go
index 18c793dbe..1264c1258 100644
--- a/pkg/routes/caldav/listStorageProvider.go
+++ b/pkg/routes/caldav/listStorageProvider.go
@@ -64,6 +64,22 @@ type VikunjaCaldavProjectStorage struct {
 	isEntry     bool // Entry level handling should only return a link to the principal url
 }
 
+// userTimezone is the zone wall-clock dates (DUE/DTSTART/DTEND) are exported in.
+// Apple clients show anything without a resolvable TZID as GMT, so this is what
+// keeps reminders local. An unset or unparsable preference returns nil, which
+// keeps the historical UTC-only export.
+func (vcls *VikunjaCaldavProjectStorage) userTimezone() *time.Location {
+	if vcls.user == nil || vcls.user.Timezone == "" {
+		return nil
+	}
+	loc, err := time.LoadLocation(vcls.user.Timezone)
+	if err != nil {
+		log.Warningf("[CALDAV] Invalid timezone %q for user %d, exporting UTC: %v", vcls.user.Timezone, vcls.user.ID, err)
+		return nil
+	}
+	return loc
+}
+
 // GetResources returns either all projects, links to the principal, or only one project, depending on the request
 func (vcls *VikunjaCaldavProjectStorage) GetResources(rpath string, withChildren bool) ([]data.Resource, error) {
 
@@ -81,6 +97,7 @@ func (vcls *VikunjaCaldavProjectStorage) GetResources(rpath string, withChildren
 
 	if vcls.isEntry {
 		r := data.NewResource(withTrailingSlash(rpath), &VikunjaProjectResourceAdapter{
+			timezone:     vcls.userTimezone(),
 			isPrincipal:  true,
 			isCollection: true,
 		})
@@ -90,6 +107,7 @@ func (vcls *VikunjaCaldavProjectStorage) GetResources(rpath string, withChildren
 	// If the request wants the principal url, we'll return that and nothing else
 	if vcls.isPrincipal {
 		r := data.NewResource(ProjectHomeSetPath, &VikunjaProjectResourceAdapter{
+			timezone:     vcls.userTimezone(),
 			isPrincipal:  true,
 			isCollection: true,
 		})
@@ -121,6 +139,7 @@ func (vcls *VikunjaCaldavProjectStorage) GetResources(rpath string, withChildren
 				emitted[href] = true
 
 				taskResource := VikunjaProjectResourceAdapter{
+					timezone:     vcls.userTimezone(),
 					project:      vcls.project,
 					task:         task,
 					isCollection: false,
@@ -148,6 +167,7 @@ func (vcls *VikunjaCaldavProjectStorage) GetResources(rpath string, withChildren
 
 	if !withChildren {
 		r := data.NewResource(withTrailingSlash(rpath), &VikunjaProjectResourceAdapter{
+			timezone:     vcls.userTimezone(),
 			isPrincipal:  true,
 			isCollection: true,
 		})
@@ -157,6 +177,7 @@ func (vcls *VikunjaCaldavProjectStorage) GetResources(rpath string, withChildren
 	var resources []data.Resource
 	for _, l := range projects {
 		rr := VikunjaProjectResourceAdapter{
+			timezone: vcls.userTimezone(),
 			project: &models.ProjectWithTasksAndBuckets{
 				Project: *l,
 			},
@@ -273,7 +294,8 @@ func (vcls *VikunjaCaldavProjectStorage) GetResourcesByList(rpaths []string) (re
 		}
 		emitted[href] = true
 		rr := VikunjaProjectResourceAdapter{
-			task: t,
+			timezone: vcls.userTimezone(),
+			task:     t,
 		}
 		addTaskResource(urlProjectID, t, &rr, &resources)
 	}
@@ -296,6 +318,7 @@ func (vcls *VikunjaCaldavProjectStorage) GetResourcesByFilters(rpath string, fil
 		var resources []data.Resource
 		for i := range vcls.project.Tasks {
 			rr := VikunjaProjectResourceAdapter{
+				timezone:     vcls.userTimezone(),
 				project:      vcls.project,
 				task:         &vcls.project.Tasks[i].Task,
 				isCollection: false,
@@ -537,8 +560,9 @@ func (vcls *VikunjaCaldavProjectStorage) GetResource(rpath string) (*data.Resour
 		}
 
 		rr := VikunjaProjectResourceAdapter{
-			project: vcls.project,
-			task:    vcls.task,
+			timezone: vcls.userTimezone(),
+			project:  vcls.project,
+			task:     vcls.task,
 		}
 		r := data.NewResource(vcls.hrefFor(rpath), &rr)
 		return &r, true, nil
@@ -668,8 +692,9 @@ func (vcls *VikunjaCaldavProjectStorage) CreateResource(rpath, content string) (
 
 	// Build up the proper response
 	rr := VikunjaProjectResourceAdapter{
-		project: vcls.project,
-		task:    vTask,
+		timezone: vcls.userTimezone(),
+		project:  vcls.project,
+		task:     vTask,
 	}
 	r := data.NewResource(rpath, &rr)
 	return &r, nil
@@ -858,8 +883,9 @@ func (vcls *VikunjaCaldavProjectStorage) UpdateResource(rpath, content string) (
 
 	// base, not vTask: Update wrote back the Updated timestamp the etag is built from.
 	rr := VikunjaProjectResourceAdapter{
-		project: vcls.project,
