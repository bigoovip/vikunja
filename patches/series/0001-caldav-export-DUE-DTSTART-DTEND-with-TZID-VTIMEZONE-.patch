+// wallClockZone is the zone wall clocks are rendered in: the CalDAV user's zone
+// when it is a real IANA zone, UTC otherwise.
+func wallClockZone(loc *time.Location) *time.Location {
+	if isIanaTimezone(loc) {
+		return loc
+	}
+	return time.UTC
+}
+
+// isIanaTimezone reports whether loc names a real IANA zone. Go's UTC, Local and
+// fixed-offset zones carry no "/" in their name and must keep the trailing-Z form.
+func isIanaTimezone(loc *time.Location) bool {
+	return loc != nil && strings.Contains(loc.String(), "/")
+}
+
+// makeCalDavWallTime renders ts as a wall clock in the user's zone, tagged with a
+// TZID parameter (";TZID=Asia/Shanghai:20261020T195900"). Clients that store what
+// the server sends then keep the intended wall clock instead of converting from
+// UTC. Without a usable zone the portable UTC form (":20261020T115900Z") is used.
+func makeCalDavWallTime(ts time.Time, loc *time.Location) string {
+	if !isIanaTimezone(loc) {
+		return ":" + makeCalDavTimeFromTimeStamp(ts)
+	}
+	return ";TZID=" + loc.String() + ":" + ts.In(loc).Format(DateFormat)
+}
+
+// formatUtcOffset renders seconds east of UTC as an RFC 5545 UTC offset (+0800).
+func formatUtcOffset(seconds int) string {
+	sign := "+"
+	if seconds < 0 {
+		sign = "-"
+		seconds = -seconds
+	}
+	return fmt.Sprintf("%s%02d%02d", sign, seconds/3600, (seconds%3600)/60)
+}
+
+// vtimezoneBlock renders a VTIMEZONE component for loc. Apple clients cannot
+// resolve a TZID without one and silently fall back to GMT. Observances are
+// derived from the zone itself (offset scan + first onset this year), so no tz
+// database has to ship and DST zones stay correct. Asia/Shanghai, which has no
+// DST, yields a single STANDARD observance.
+func vtimezoneBlock(loc *time.Location) (block string) {
+	year := time.Now().In(loc).Year()
+	start := time.Date(year, time.January, 1, 0, 0, 0, 0, loc)
+	end := start.AddDate(1, 0, 0)
+
+	type observance struct {
+		name   string
+		offset int
+		onset  time.Time
+	}
+	byOffset := map[int]*observance{}
+	for probe := start; probe.Before(end); probe = probe.Add(time.Hour) {
+		name, offset := probe.Zone()
+		if _, ok := byOffset[offset]; !ok {
+			byOffset[offset] = &observance{name: name, offset: offset, onset: probe}
+		}
+	}
+
+	offsets := make([]int, 0, len(byOffset))
+	for offset := range byOffset {
+		offsets = append(offsets, offset)
+	}
+	sort.Ints(offsets)
+	if len(offsets) > 2 {
+		// Historical oddities: keep the two the zone actually uses most recently.
+		offsets = offsets[len(offsets)-2:]
+	}
+
+	var b strings.Builder
+	b.WriteString("\nBEGIN:VTIMEZONE\nTZID:" + loc.String() + "\n")
+	for i, offset := range offsets {
+		kind := "STANDARD"
+		if len(offsets) == 2 && i == len(offsets)-1 {
+			// Daylight saving always adds time, so the larger offset is DAYLIGHT.
+			kind = "DAYLIGHT"
+		}
+		o := byOffset[offset]
+		b.WriteString("BEGIN:" + kind + "\n")
+		b.WriteString("DTSTART:" + o.onset.UTC().Format(DateFormat) + "Z\n")
+		b.WriteString("TZOFFSETFROM:" + formatUtcOffset(offset) + "\n")
+		b.WriteString("TZOFFSETTO:" + formatUtcOffset(offset) + "\n")
+		if o.name != "" {
+			b.WriteString("TZNAME:" + escapeICalText(o.name) + "\n")
+		}
+		b.WriteString("END:" + kind + "\n")
+	}
+	b.WriteString("END:VTIMEZONE")
+	return b.String()
+}
+
 func makeCalDavDuration(duration time.Duration) (caldavtime string) {
 	if duration < 0 {
 		duration = duration.Abs()
